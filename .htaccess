# MEDISA Taşıt Yönetim Sistemi
# RewriteBase /medisa/ veya / gerektiğinde script tarafından ayarlanır

# Favicon: bu dizinde favicon.ico isteği icon/favicon.ico'dan servis edilsin
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:\.git|\.github)(?:/|$) - [F,L,NC]
  RewriteRule ^data(/|$) - [F,L,NC]
  RewriteRule ^favicon\.ico$ icon/favicon.ico [L]
  # FilesMatch query string görmez; uzun cache yalnız ?v= pin'li JS/CSS için
  RewriteCond %{QUERY_STRING} (?:^|&)v=
  RewriteRule \.(?:js|css)$ - [E=MEDISA_VERSIONED_ASSET:1]
</IfModule>

# Metin tabanlı statik/dinamik yanıtlar için gzip (binary görseller hariç)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# Service Worker: scope hatasını önlemek için (mod_headers gerekir)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self'"

  # Cache-busted (?v=) JS/CSS — versionsuz mutable istekler (örn. SW precache) alınmaz
  Header set Cache-Control "public, max-age=31536000, immutable" env=MEDISA_VERSIONED_ASSET

  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header unset Cache-Control
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# Dokümantasyon (.md) sunucuda servis edilmesin
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Deploy state ve geliştirme dosyaları web üzerinden servis edilmesin
<FilesMatch "^(?:\.cpanel\.yml|\.editorconfig|\.ftp-deploy-sync-state\.json|package\.json|config\.local\.php)$">
    Require all denied
</FilesMatch>
