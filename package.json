{
  "name": "tasitmedisa-tooling",
  "private": true,
  "description": "Operational tooling for the MEDISA vehicle management workspace.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tool:verify-roles": "node scripts/run-medisa-role-matrix-verify.js",
    "tool:verify-login-title-fit": "node scripts/verify-driver-login-title-fit.js",
    "tool:verify-visible-store": "node scripts/verify-medisa-visible-store-invariants.js",
    "tool:measure-visible-store": "node scripts/measure-medisa-visible-store.js",
    "tool:verify-save-wire": "node scripts/run-medisa-save-wire-verify.js",
    "tool:measure-save-wire": "node scripts/measure-medisa-save-wire.js",
    "tool:verify-kasko-lookup": "node scripts/run-medisa-kasko-lookup-verify.js",
    "tool:verify-vehicle-render": "node scripts/verify-medisa-vehicle-render-invariants.js",
    "tool:verify-vehicle-detail-olay": "node scripts/verify-medisa-vehicle-detail-olay-invariants.js",
    "tool:verify-vehicle-history-ui": "node scripts/verify-medisa-vehicle-history-ui-invariants.js",
    "tool:verify-import-source-of-truth": "node scripts/verify-medisa-import-source-of-truth-invariants.js",
    "tool:verify-server-restore": "node scripts/verify-medisa-server-restore-invariants.js",
    "tool:measure-vehicle-render": "node scripts/measure-medisa-vehicle-render.js",
    "tool:verify-driver-lazy": "node scripts/verify-medisa-driver-lazy-invariants.js && node scripts/verify-medisa-driver-cold-dependencies.js",
    "tool:measure-driver-boot": "node scripts/measure-medisa-driver-boot.js",
    "tool:verify-main-shell": "node scripts/verify-medisa-main-shell-lazy-invariants.js",
    "tool:verify-thin-shell": "node scripts/verify-medisa-thin-shell-interaction-invariants.js",
    "tool:verify-deploy": "node scripts/verify-medisa-deploy-invariants.js",
    "tool:verify-staging-isolation": "node scripts/verify-medisa-staging-isolation.js",
    "tool:verify-staging-ftps": "node scripts/verify-medisa-staging-ftps.js",
    "tool:verify-password-migration": "php scripts/verify-medisa-password-migration.php",
    "tool:verify-default-credentials": "php scripts/verify-medisa-default-credentials.php",
    "tool:verify-mandatory-password-change": "php scripts/verify-medisa-mandatory-password-change.php && node scripts/verify-medisa-mandatory-password-change-invariants.js",
    "tool:verify-runtime-data-git": "node scripts/verify-medisa-runtime-data-git-invariants.js",
    "tool:inspect-runtime-data-health": "php scripts/inspect-medisa-runtime-data-health.php",
    "tool:verify-runtime-data-health": "php scripts/verify-medisa-runtime-data-health.php",
    "tool:notification-scope-cleanup": "php scripts/migrate-medisa-notification-scope-legacy.php",
    "tool:verify-notification-scope-cleanup": "php scripts/verify-medisa-notification-scope-legacy.php",
    "tool:measure-main-shell": "node scripts/measure-medisa-main-shell.js",
    "tool:import-gpt-xlsx": "node scripts/import_gpt_xlsx.mjs",
    "tool:build-deploy-zip": "powershell -ExecutionPolicy Bypass -File scripts/build-deploy-zip.ps1"
  },
  "dependencies": {
    "@oai/artifact-tool": "2.6.9",
    "jszip": "3.10.1"
  }
}
