{
  "name": "tasitmedisa-tooling",
  "private": true,
  "description": "Operational tooling for the MEDISA vehicle management workspace.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tool:verify-roles": "node scripts/verify-medisa-role-invariants.js",
    "tool:verify-vehicle-save": "node scripts/verify-medisa-vehicle-save-invariants.js",
    "tool:verify-sensitive-data": "node scripts/verify-medisa-sensitive-data.js",
    "tool:verify-user-password": "php scripts/verify-medisa-user-password-invariants.php",
    "tool:verify-portal-account-endpoint": "php scripts/verify-medisa-portal-account-endpoint.php",
    "tool:dry-run-portal-accounts": "php scripts/dry-run-medisa-portal-accounts.php",
    "tool:apply-portal-accounts": "php scripts/apply-medisa-portal-accounts.php",
    "tool:verify-portal-accounts-apply": "php scripts/verify-medisa-portal-accounts-apply.php",
    "tool:verify-km-state": "php scripts/verify-medisa-km-state-invariants.php",
    "tool:verify-kasko-lookup": "php scripts/verify-medisa-kasko-lookup-invariants.php",
    "tool:verify-save-wire": "node scripts/run-medisa-save-wire-verify.js",
    "tool:measure-save-wire": "node scripts/measure-medisa-save-wire.js",
    "tool:verify-vehicle-render": "node scripts/verify-medisa-vehicle-render-invariants.js",
    "tool:measure-vehicle-render": "node scripts/measure-medisa-vehicle-render.js",
    "tool:verify-driver-lazy": "node scripts/verify-medisa-driver-lazy-invariants.js",
    "tool:measure-driver-boot": "node scripts/measure-medisa-driver-boot.js",
    "tool:verify-visible-store": "node scripts/verify-medisa-visible-store-invariants.js",
    "tool:measure-visible-store": "node scripts/measure-medisa-visible-store.js",
    "tool:import-gpt-xlsx": "node scripts/import_gpt_xlsx.mjs",
    "tool:build-deploy-zip": "powershell -ExecutionPolicy Bypass -File scripts/build-deploy-zip.ps1"
  },
  "dependencies": {
    "@oai/artifact-tool": "2.6.9",
    "jszip": "3.10.1"
  }
}
